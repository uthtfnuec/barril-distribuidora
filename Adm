

<!DOCTYPE html>

<html lang="pt-BR">

<head>

  <meta charset="UTF-8">

  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>Administração | Barril Distribuidora</title>

  <style>

    * { box-sizing: border-box; }

    body {

      margin: 0;

      padding: 16px;

      font-family: Arial, sans-serif;

      background: #f4f1eb;

      color: #30251e;

    }

    header {

      background: #35251b;

      color: white;

      padding: 22px;

      border-radius: 12px;

      margin-bottom: 18px;

    }

    h1 { margin: 0 0 8px; font-size: 24px; }

    h2 { font-size: 20px; }

    a { color: #fff; }

    section {

      background: white;

      padding: 18px;

      border-radius: 12px;

      margin-bottom: 18px;

    }

    label {

      display: block;

      margin-top: 14px;

      font-weight: bold;

      font-size: 14px;

    }

    input, select {

      width: 100%;

      padding: 12px;

      margin-top: 6px;

      border: 1px solid #ccc;

      border-radius: 7px;

      font-size: 16px;

      background: white;

    }

    button {

      border: 0;

      border-radius: 7px;

      padding: 12px;

      margin-top: 14px;

      background: #754326;

      color: white;

      font-weight: bold;

      font-size: 14px;

      cursor: pointer;

    }

    .produto {

      border: 1px solid #ddd;

      border-radius: 9px;

      padding: 13px;

      margin-top: 13px;

      overflow-wrap: anywhere;

    }

    .produto img {

      display: block;

      width: 100%;

      max-width: 180px;

      max-height: 180px;

      object-fit: contain;

      margin: 10px 0;

    }

    .produto button { margin-right: 6px; }

    .remover { background: #a52a2a; }

    .aviso {

      background: #fff0c7;

      padding: 12px;

      border-radius: 8px;

      font-size: 14px;

      line-height: 1.5;

    }

    .secundario { background: #555; }

  </style>

</head>

<body>

<header>

  <h1>🛒 Barril Distribuidora</h1>

  <p>Painel de administração</p>

  <a href="./">Voltar para o site</a>

</header>

<p class="aviso">

  Demonstração: os produtos ficam salvos somente neste navegador.

  Este painel ainda não está conectado ao catálogo público nem possui

  login seguro. Não use como sistema comercial definitivo.

</p>

<section>

  <h2 id="titulo-formulario">Adicionar produto</h2>

  <label for="nome">Nome do produto</label>

  <input id="nome" placeholder="Ex.: Refrigerante 2 litros">

  <label for="categoria">Categoria</label>

  <select id="categoria">

    <option value="Bebidas e refrigerantes">Bebidas e refrigerantes</option>

    <option value="Energéticos">Energéticos</option>

    <option value="Água">Água</option>

    <option value="Gelo">Gelo</option>

    <option value="Carvão">Carvão</option>

    <option value="Produtos de limpeza">Produtos de limpeza</option>

    <option value="Mercearia">Mercearia</option>

    <option value="Outros">Outros</option>

  </select>

  <label for="preco">Preço (R$)</label>

  <input id="preco" type="number" min="0" step="0.01"

    placeholder="Ex.: 8.50">

  <label for="estoque">Quantidade em estoque</label>

  <input id="estoque" type="number" min="0" step="1"

    placeholder="Ex.: 20">

  <label for="imagem">Link da foto do produto</label>

  <input id="imagem" type="url"

    placeholder="https://exemplo.com/foto.jpg">

  <button id="botao-salvar" onclick="salvarProduto()">

    Cadastrar produto

  </button>

  <button class="secundario" onclick="limparFormulario()">

    Limpar campos

  </button>

</section>

<section>

  <h2>Produtos cadastrados</h2>

  <label for="filtro">Filtrar por categoria</label>

  <select id="filtro" onchange="mostrarProdutos()">

    <option value="">Todas as categorias</option>

    <option value="Bebidas e refrigerantes">Bebidas e refrigerantes</option>

    <option value="Energéticos">Energéticos</option>

    <option value="Água">Água</option>

    <option value="Gelo">Gelo</option>

    <option value="Carvão">Carvão</option>

    <option value="Produtos de limpeza">Produtos de limpeza</option>

    <option value="Mercearia">Mercearia</option>

    <option value="Outros">Outros</option>

  </select>

  <div id="lista"></div>

</section>

<script>

  const CHAVE = "barril_demo_produtos";

  let produtos = [];

  try {

    const dados = JSON.parse(localStorage.getItem(CHAVE) || "[]");

    if (Array.isArray(dados)) produtos = dados;

  } catch (e) {

    produtos = [];

  }

  let editandoId = null;

  function guardar() {

    try {

      localStorage.setItem(CHAVE, JSON.stringify(produtos));

      mostrarProdutos();

    } catch (e) {

      alert("Não foi possível salvar os dados neste navegador.");

    }

  }

  function limparFormulario() {

    document.getElementById("nome").value = "";

    document.getElementById("categoria").selectedIndex = 0;

    document.getElementById("preco").value = "";

    document.getElementById("estoque").value = "";

    document.getElementById("imagem").value = "";

    document.getElementById("titulo-formulario").textContent =

      "Adicionar produto";

    document.getElementById("botao-salvar").textContent =

      "Cadastrar produto";

    editandoId = null;

  }

  function salvarProduto() {

    const nome = document.getElementById("nome").value.trim();

    const categoria = document.getElementById("categoria").value;

    const precoTexto = document.getElementById("preco").value;

    const estoqueTexto = document.getElementById("estoque").value;

    const imagem = document.getElementById("imagem").value.trim();

    const preco = Number(precoTexto);

    const estoque = Number(estoqueTexto);

    if (!nome || precoTexto === "" || !Number.isFinite(preco) ||

        preco < 0 || estoqueTexto === "" ||

        !Number.isInteger(estoque) || estoque < 0) {

      alert("Preencha nome, preço e estoque corretamente.");

      return;

    }

    if (imagem) {

      try {

        const url = new URL(imagem);

        if (url.protocol !== "https:" && url.protocol !== "http:") {

          alert("Use um link de foto começando com http:// ou https://");

          return;

        }

      } catch (e) {

        alert("Digite um link de foto válido.");

        return;

      }

    }

    const produto = {

      id: editandoId ?? Date.now(),

      nome,

      categoria,

      preco,

      estoque,

      imagem

    };

    if (editandoId !== null) {

      const indice = produtos.findIndex(p => p.id === editandoId);

      if (indice !== -1) produtos[indice] = produto;

    } else {

      produtos.push(produto);

    }

    guardar();

    limparFormulario();

    alert("Produto salvo nesta demonstração!");

  }

  function editarProduto(id) {

    const p = produtos.find(item => item.id === id);

    if (!p) return;

    editandoId = id;

    document.getElementById("nome").value = p.nome;

    document.getElementById("categoria").value = p.categoria;

    document.getElementById("preco").value = p.preco;

    document.getElementById("estoque").value = p.estoque;

    document.getElementById("imagem").value = p.imagem || "";

    document.getElementById("titulo-formulario").textContent =

      "Editar produto";

    document.getElementById("botao-salvar").textContent =

      "Salvar alterações";

    window.scrollTo({ top: 0, behavior: "smooth" });

  }

  function removerProduto(id) {

    if (!confirm("Deseja remover este produto?")) return;

    produtos = produtos.filter(p => p.id !== id);

    guardar();

  }

  function mostrarProdutos() {

    const lista = document.getElementById("lista");

    const filtro = document.getElementById("filtro").value;

    lista.replaceChildren();

    const filtrados = produtos.filter(p =>

      !filtro || p.categoria === filtro

    );

    if (filtrados.length === 0) {

      lista.textContent = "Nenhum produto nesta categoria.";

      return;

    }

    filtrados.forEach(p => {

      const card = document.createElement("div");

      card.className = "produto";

      const nome = document.createElement("strong");

      nome.textContent = p.nome;

      const categoria = document.createElement("p");

      categoria.textContent = "Categoria: " + p.categoria;

      const preco = document.createElement("p");

      preco.textContent =

        "Preço: R$ " + p.preco.toFixed(2).replace(".", ",");

      const estoque = document.createElement("p");

      estoque.textContent = "Estoque: " + p.estoque + " unidade(s)";

      card.append(nome, categoria, preco, estoque);

      if (p.imagem) {

        const img = document.createElement("img");

        img.src = p.imagem;

        img.alt = "Foto do produto";

        img.loading = "lazy";

        img.onerror = () => {

          img.alt = "Não foi possível carregar esta foto.";

          img.removeAttribute("src");

        };

        card.append(img);

      }

      const editar = document.createElement("button");

      editar.textContent = "Editar";

      editar.onclick = () => editarProduto(p.id);

      const remover = document.createElement("button");

      remover.textContent = "Remover";

      remover.className = "remover";

      remover.onclick = () => removerProduto(p.id);

      card.append(editar, remover);

      lista.append(card);

    });

  }

  mostrarProdutos();

</script>

</body>

</html>
